let trace_domain: Pcs::Domain = // computed in the same way as on Prover
let sels: LagrangeSelectors<Challenge> = trace_domain.selectors_at_point(zeta);

let quotient: Challenge = // computed by restoring quotient from chunks we got from Prover
```

### Response

